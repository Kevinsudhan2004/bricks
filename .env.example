# PostgreSQL connection string
DATABASE_URL=postgres://bricks:bricks_dev_password@localhost:5433/bricks_crm

# Business timezone used for "today" (production/inbound dates)
APP_TIMEZONE=Asia/Kolkata

# Initial logins created by `npm run db:seed` (change after first login)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=change-me-owner
SEED_EMPLOYEE_USERNAME=employee
SEED_EMPLOYEE_PASSWORD=change-me-employee
